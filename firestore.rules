rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users koleksiyonu: sadece yetkili kullanıcı kendi dokümanını oluşturup yönetebilir
    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    // basit tip doğrulamaları
                    && request.resource.data.email is string
                    && request.resource.data.username is string;
      // Allow authenticated users to read profiles (project choice A)
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // pets koleksiyonu: örnek yetkilendirme
    match /pets/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && (
                      request.resource.data.ownerId == request.auth.uid
                      || request.resource.data.createdByUid == request.auth.uid
                    );
      allow update, delete: if request.auth != null
                            && (
                              resource.data.ownerId == request.auth.uid
                              || resource.data.createdByUid == request.auth.uid
                            );
      // Allow reading and adding records in subcollections like feeds, treatments, locations
      match /{subCollection=**} {
        allow read: if true;
        allow create: if request.auth != null;
        // only the creator can update/delete their records
        allow update, delete: if request.auth != null && resource.data.addedBy == request.auth.uid;
      }
    }
  }
}
