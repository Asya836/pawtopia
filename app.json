{
  "expo": {
    "name": "pawtopia",
    "slug": "pawtopia-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-square.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo2.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.asya.pawtopia",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/logo1.png"
    }
  }
}